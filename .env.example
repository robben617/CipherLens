# CipherLens 环境变量样例（不含真实密钥）
# 用法：复制成 backend/.env（后端启动时自动读，且不会覆盖已存在的环境变量）

# 数据库（预留：当前 backend/db.py 固定使用 backend/data/cipherlens.db）
CIPHERLENS_DB_PATH=
CIPHERLENS_DB_BACKUP=1

# ---- LLM（F10 起真正启用）----
# 留空 = 不接模型：AI 区自动降级成本地模板讲解，其余功能不受影响。
# 地址填 OpenAI 兼容的根路径，末尾不要带 /chat/completions
# 例：https://api.deepseek.com/v1
LLM_BASE_URL=
# 只从环境变量读，不进代码、不进日志、不落库
LLM_API_KEY=
# 例：deepseek-chat
LLM_MODEL=
# 单次请求超时（秒）；失败自动重试一次，第二次按 1.5 倍算
LLM_TIMEOUT_S=20
# 单次回答上限 token（教学场景一段话 200 字够了）
LLM_MAX_TOKENS=400

# 前端构建（未设置时保持 '/' 与 Vite 默认 target）
VITE_BASE=/
VITE_BUILD_TARGET=
